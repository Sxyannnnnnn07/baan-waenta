# Public Google OAuth client identifier; must match the browser OAuth client.
GOOGLE_CLIENT_ID=105484503874-92cu9940o9od95nb2pna8pr0kkf7pngi.apps.googleusercontent.com

# Used only when the users table is empty. Use a strong unique password.
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Strong-Password-123!

# Keep private payment slips and server logs outside public/.
STORAGE_DIR=./storage
